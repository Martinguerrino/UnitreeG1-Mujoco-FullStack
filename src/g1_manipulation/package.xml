<?xml version="1.0"?>
<package format="3">
  <name>g1_manipulation</name>
  <version>0.1.0</version>
  <description>MoveIt 2 motion-planning examples for the Unitree G1.</description>
  <maintainer email="maintainer@example.com">G1 Locomanipulation Maintainer</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>geometry_msgs</depend>
  <depend>moveit_ros_planning_interface</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>g1_interfaces</depend>
  <depend>shape_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <exec_depend>g1_bringup</exec_depend>
