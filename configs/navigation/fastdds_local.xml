<?xml version="1.0" encoding="UTF-8"?>
<!-- ROS traffic remains on loopback. Avoid stale Fast DDS SHM ports after
     GUI crashes or interrupted launches. Unitree SDK uses a separate domain. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>g1_navigation_udp</transport_id>
      <type>UDPv4</type>
      <interfaceWhiteList><address>127.0.0.1</address></interfaceWhiteList>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="g1_navigation_local" is_default_profile="true">
    <rtps>
      <userTransports><transport_id>g1_navigation_udp</transport_id></userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
